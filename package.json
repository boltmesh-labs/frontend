{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:mocked": "playwright test --project=chromium --project=mobile-chromium",
    "test:e2e:live": "playwright test --config=playwright.live.config.js",
    "test:e2e:live:write": "playwright test --config=playwright.live-write.config.js",
    "test:e2e:cross-browser": "playwright test --project=chromium --project=mobile-chromium --project=firefox --project=webkit",
    "test:e2e:production": "playwright test --config=playwright.production.config.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint 'src/**/*.{js,jsx}' 'e2e/**/*.{js,jsx}' vite.config.js 'playwright*.config.js' eslint.config.js",
    "lint:fix": "eslint 'src/**/*.{js,jsx}' 'e2e/**/*.{js,jsx}' vite.config.js 'playwright*.config.js' eslint.config.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "react": "^19.3.1",
    "react-bootstrap": "^3.0.0-beta.5",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.4",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
