{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.{js,jsx}' vite.config.js eslint.config.js",
    "lint:fix": "eslint 'src/**/*.{js,jsx}' vite.config.js eslint.config.js --fix",
    "format": "prettier --write 'src/**/*.{js,jsx,json,css,md}' vite.config.js eslint.config.js index.html package.json",
    "format:check": "prettier --check 'src/**/*.{js,jsx,json,css,md}' vite.config.js eslint.config.js index.html package.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "react": "^19.2.8",
    "react-bootstrap": "^3.0.0-beta.5",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
