{
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[terraform]": { "editor.formatOnSave": true },
  "[go]": {
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.rulers": [80],
    "editor.selectionHighlight": false,
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "**/node_modules": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/htmlcov": true,
    "**/.coverage": true,
    "**/*.egg-info": true,
    "**/.terraform": true,
    "**/.external_modules": true,
    "**/coverage": true,
    "**/dist": true,
    "**/.grimp_cache": true,
    "**/.import_linter_cache": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/target/**": true,
    "**/build/**": true
  },
  "terminal.integrated.stickyScroll.enabled": false,
  "python.analysis.typeCheckingMode": "standard",
  "containers.containers.label": "ContainerName",
  "dart.flutterSdkPaths": ["/home/revolver1/development/flutter"],
  "dart.sdkPaths": ["/home/revolver1/development/flutter/bin/cache/dart-sdk"]
}
