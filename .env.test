# Environment for Vitest only (mode `test`), loaded above the developer's
# untracked `.env`.
#
# Without this, unit tests inherit whatever `.env` a machine happens to have:
# a test asserting configured copy then passes or fails depending on who runs
# it, and nothing in CI would ever see the failure. Values below are the
# fallbacks in `src/utils/config.js`, so tests behave like a fresh clone.
#
# Changing one of these means updating the tests that assert it.
VITE_API_URL=http://localhost:8000/v1
VITE_APP_COMPANY_NAME="BoltMesh VPN"
VITE_APP_SUPPORT_EMAIL="support@example.com"
