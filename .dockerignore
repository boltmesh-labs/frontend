# Keep the build context small and secret-free: without this, COPY . . ships
# hundreds of MB of node_modules plus local state and .env files into every
# image layer and invalidates cache on every dependency change.
node_modules
dist
coverage
# Playwright's own output: copied into the image by `COPY . .`, which ships
# whatever the last local run left behind and makes it easy to mistake a stale
# report for a fresh one. Mount these as volumes instead (see
# Dockerfile.playwright).
playwright-report
test-results
blob-report
artifacts
.git
.env
.env.*
!.env.example
*.log
.eslintcache
